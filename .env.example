# Environment files
.env.local
.env.*.local

# Server Configuration (example)
# Copy to .env and adjust for your environment

# Security - CORS Configuration
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:3000,https://yourdomain.com

# Resource Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=100

# Job Management  
JOB_TTL_MINUTES=60

# Server Configuration
PORT=3000
VIPS_CONCURRENCY=4

# Logging
RUST_LOG=info
