{
    "productName": "image-processor",
    "version": "0.1.0",
    "identifier": "com.myprocessor.imageopt",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "bundle": {
        "active": true,
        "targets": ["app"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico",
            "icons/icon.icns"
        ],
        "resources": ["resources/models/*"],
        "macOS": {
            "entitlements": "Entitlements.plist"
        }
    },
    "app": {
        "security": {
            "csp": null
        },
        "windows": [
            {
                "title": "Image Processor",
                "width": 1000,
                "height": 700,
                "minWidth": 800,
                "minHeight": 600,
                "center": true,
                "titleBarStyle": "Visible",
                "hiddenTitle": false,
                "dragDropEnabled": true
            }
        ]
    }
}
